# --- FileList credentials ---
FILELIST_USERNAME=your_username

# Option A (recommended for full browsing with pages): website login with your password
FILELIST_PASSWORD=your_password

# Option B: official API with your passkey (filelist.io -> Profile -> passkey).
# Used only when FILELIST_PASSWORD is empty. Shows the latest 100 movies + search, no paging.
FILELIST_PASSKEY=

# --- App settings (optional) ---
PORT=3000
# Use 0.0.0.0 to open the app from other devices on your network (no authentication!)
HOST=127.0.0.1
DOWNLOAD_DIR=./downloads
DATA_DIR=./data

# --- qBittorrent Web UI (FileList only allows whitelisted clients, so downloads go through qBittorrent) ---
# Enable in qBittorrent: Tools > Options > Web UI. The app starts qBittorrent automatically if it's installed.
QBIT_URL=http://127.0.0.1:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=
# Only needed if qbittorrent.exe is not in C:\Program Files\qBittorrent
QBIT_PATH=

# ffmpeg converts what a device can't play (audio, or the whole video at a lower quality). Found automatically on
# PATH or in a winget install; set these only for another location.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional: OpenSubtitles.com (free API key: profile -> API consumers). Logging in raises the daily download limit.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
OPENSUBTITLES_LANGUAGES=ro,en

# 0 = don't open the browser when the app starts
OPEN_BROWSER=1
